+"""Explicit chip-child service lifecycle and allocation pinning."""
+
+from __future__ import annotations
+
+import os
+import threading
+from collections.abc import Iterator
+from contextlib import contextmanager
+from typing import Any, Callable, Protocol
+
+
+class ChipService(Protocol):
+    def close(self) -> None:
+        """Stop and join all service threads before returning; raise if unsafe."""
+        ...
+
+
+class ChipServiceContext:
+    """Owner-private resolver. Pins serialize against the chip control free path."""
+
+    def __init__(self, device_id: int, owner_instance_id: bytes, resolver: Any):
+        self.device_id = device_id
+        self.owner_instance_id = owner_instance_id
+        self.pid = os.getpid()
+        self._resolver = resolver
+        self._pins: dict[str, tuple[int, int]] = {}
+        self._lock = threading.RLock()
+        self._closed = False
+        self._service_closed = False
+
+    def pin(self, token: str, descriptor: Any) -> tuple[int, int]:
+        with self._lock:
+            if token in self._pins:
+                raise ValueError("service allocation token already pinned")
+            imported = self._resolver.materialize(descriptor)
+            self._pins[token] = (int(imported.base), int(descriptor.nbytes))
+            return self._pins[token]
+
+    def unpin(self, token: str) -> None:
+        with self._lock:
+            del self._pins[token]
+
+    @contextmanager
+    def freeing(self, address: int) -> Iterator[None]:
+        with self._lock:
+            if any(base == address for base, _ in self._pins.values()):
+                raise RuntimeError("allocation is pinned by a chip service")
+            yield
+
+    def close(self) -> None:
+        with self._lock:
+            if self._closed:
+                return
+            if self._pins:
+                raise RuntimeError("chip service closed with live allocation pins")
+            self._resolver.close()
+            self._closed = True
+
+    def close_service(self, service: ChipService) -> None:
+        """Close the service and resolver exactly once on nested teardown paths."""
+        if self._service_closed:
+            return
+        service.close()
+        self.close()
+        self._service_closed = True
+
+
+def validate_service_config(level: int, config: dict) -> dict:
+    factories = config.get("chip_service_factories", {})
+    if not isinstance(factories, dict) or (
+        factories
+        and (
+            level != 3
+            or any(
+                type(rank) is not int
+                or not 0 <= rank < len(config.get("device_ids", ()))
+                or not callable(factory)
+                for rank, factory in factories.items()
+            )
+        )
+    ):
+        raise ValueError(
+            "chip_service_factories requires callable factories keyed by local chip rank"
+        )
+    return dict(config, chip_service_factories=dict(factories)) if factories else config
+
+
+def start_chip_service(
+    factory: Callable | None,
+    device_id: int,
+    owner_instance_id: bytes,
+    resolver: Any,
+):
+    """Start a service after chip initialization and before readiness publication."""
+    if factory is None:
+        return None, None
+    context = ChipServiceContext(device_id, owner_instance_id, resolver)
+    service = factory(context)
+    if not callable(getattr(service, "close", None)):
+        raise TypeError("chip service factory must return a service with close()")
+    return context, service
+
+
+def close_chip_service(context: Any, service: Any) -> None:
+    """Unsafe service teardown exits without device allocator/context cleanup."""
+    if service is None:
+        return
+    try:
+        context.close_service(service)
+    except BaseException:
+        os._exit(75)
